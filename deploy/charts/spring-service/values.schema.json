{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "replicas", "secretName", "env", "secretEnv", "resources"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "tag", "pullPolicy"],
      "properties": {
        "registry": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      },
      "if": { "properties": { "pullPolicy": { "const": "Never" } } },
      "then": { "properties": { "tag": { "const": "working-tree" } } },
      "else": { "properties": { "tag": { "pattern": "^(v[0-9]+\\.[0-9]+\\.[0-9]+|[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[0-9a-f]{7,40})$" } } }
    },
    "replicas": { "type": "integer", "minimum": 0 },
    "secretName": { "type": "string", "minLength": 1 },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "secretEnv": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" } },
    "resources": { "type": "object" }
  }
}
