{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["gatewayClassName", "standalone", "replicas", "resources", "listeners", "backendPort", "connectTimeout", "staff", "adminConsole", "customerSite"],
  "definitions": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "limit": { "type": "string", "pattern": "^[a-z][A-Za-z]*$" }
  },
  "properties": {
    "gatewayClassName": { "$ref": "#/definitions/name" },
    "standalone": { "type": "boolean" },
    "replicas": { "type": "integer", "minimum": 1 },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": { "type": "object", "additionalProperties": { "type": "string" } },
        "limits": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "listeners": {
      "type": "object",
      "additionalProperties": false,
      "required": ["web", "admin"],
      "properties": { "web": { "$ref": "#/definitions/port" }, "admin": { "$ref": "#/definitions/port" } }
    },
    "backendPort": { "$ref": "#/definitions/port" },
    "connectTimeout": { "type": "string", "pattern": "^[0-9]+(ms|s)$" },
    "staff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "jwksUri", "audience", "roles"],
      "properties": {
        "issuer": { "type": "string", "pattern": "^https?://" },
        "jwksUri": { "type": "string", "pattern": "^https?://" },
        "audience": { "type": "string", "minLength": 1 },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/name" } }
        }
      }
    },
    "adminConsole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "identity", "services", "routes"],
      "properties": {
        "site": { "$ref": "#/definitions/name" },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["backend", "paths"],
          "properties": {
            "backend": { "$ref": "#/definitions/name" },
            "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^/.+/$" } }
          }
        },
        "services": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/definitions/name" } },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "service", "method", "path"],
            "properties": {
              "role": { "$ref": "#/definitions/name" },
              "service": { "$ref": "#/definitions/name" },
              "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
              "path": { "type": "string", "pattern": "^/" }
            }
          }
        }
      }
    },
    "customerSite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site", "services", "routes", "limits"],
      "properties": {
        "site": { "$ref": "#/definitions/name" },
        "services": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/definitions/name" } },
        "routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["service", "method", "path"],
            "properties": {
              "service": { "$ref": "#/definitions/name" },
              "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
              "path": { "type": "string", "pattern": "^/" },
              "limit": { "$ref": "#/definitions/limit" }
            }
          }
        },
        "limits": {
          "type": "object",
          "required": ["all"],
          "propertyNames": { "$ref": "#/definitions/limit" },
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requests", "unit"],
            "properties": {
              "requests": { "type": "integer", "minimum": 1 },
              "unit": { "enum": ["Second", "Minute", "Hour"] }
            }
          }
        }
      }
    }
  }
}
