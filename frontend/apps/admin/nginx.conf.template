map $request_uri $jaypay_upstream {
    ~^/api/membership/         ${JAYPAY_MEMBERSHIP_URL};
    ~^/api/payment/            ${JAYPAY_PAYMENT_URL};
    ~^/api/money-aggregation/  ${JAYPAY_MONEY_AGGREGATION_URL};
    ~^/api/money-query/        ${JAYPAY_MONEY_QUERY_URL};
    ~^/api/auth/staff/         ${JAYPAY_AUTH_URL};
}

server {
    listen 8080;
    root /usr/share/nginx/html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location ~ ^/api/(membership|payment|money-aggregation|money-query)/ {
        auth_request /_authorize;
        error_page 401 @unauthenticated;
        error_page 403 @forbidden;
        rewrite ^/api/[a-z-]+(/.*)$ $1 break;
        proxy_pass $jaypay_upstream;
        proxy_connect_timeout 5s;
    }

    location /api/auth/staff/ {
        rewrite ^/api/auth(/.*)$ $1 break;
        proxy_pass $jaypay_upstream;
        proxy_connect_timeout 5s;
    }

    location /api/ {
        return 404;
    }

    location = /_authorize {
        internal;
        set $jaypay_auth ${JAYPAY_AUTH_URL};
        proxy_pass $jaypay_auth/authorize$request_uri;
        proxy_method $request_method;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_connect_timeout 5s;
    }

    location @unauthenticated {
        default_type application/json;
        return 401 '{"error":"UNAUTHENTICATED","message":"Sign in again."}';
    }

    location @forbidden {
        default_type application/json;
        return 403 '{"error":"FORBIDDEN","message":"Your role does not allow this."}';
    }

    location / {
        try_files $uri /index.html;
    }
}
