map $request_uri $jaypay_upstream {
    ~^/api/membership/         ${JAYPAY_MEMBERSHIP_URL};
    ~^/api/payment/            ${JAYPAY_PAYMENT_URL};
    ~^/api/money-aggregation/  ${JAYPAY_MONEY_AGGREGATION_URL};
    ~^/api/money-query/        ${JAYPAY_MONEY_QUERY_URL};
}

server {
    listen 8080;
    root /usr/share/nginx/html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location ~ ^/api/(membership|payment|money-aggregation|money-query)/ {
        rewrite ^/api/[a-z-]+(/.*)$ $1 break;
        proxy_pass $jaypay_upstream;
        proxy_connect_timeout 5s;
    }

    location /api/ {
        return 404;
    }

    location / {
        try_files $uri /index.html;
    }
}
