map_hash_bucket_size 128;

map "$request_method $uri" $jaypay_upstream {
    default                                                              "";
    "POST /api/membership/memberships"                                   ${JAYPAY_MEMBERSHIP_URL}/memberships;
    "POST /api/membership/memberships/login"                             ${JAYPAY_MEMBERSHIP_URL}/memberships/login;
    "POST /api/membership/memberships/token-validate"                    ${JAYPAY_MEMBERSHIP_URL}/memberships/token-validate;
    "POST /api/membership/memberships/refresh-token"                     ${JAYPAY_MEMBERSHIP_URL}/memberships/refresh-token;
    "~^GET /api/membership/memberships/(?<jaypay_id>[0-9]+)$"            ${JAYPAY_MEMBERSHIP_URL}/memberships/$jaypay_id;
    "~^GET /api/banking/banking/account/(?<jaypay_id>[0-9]+)$"           ${JAYPAY_BANKING_URL}/banking/account/$jaypay_id;
    "POST /api/banking/banking/account/register"                         ${JAYPAY_BANKING_URL}/banking/account/register;
    "POST /api/money/money/member-money"                                 ${JAYPAY_MONEY_URL}/money/member-money;
    "POST /api/money/money/increase"                                     ${JAYPAY_MONEY_URL}/money/increase;
    "POST /api/remittance/remittance/request"                            ${JAYPAY_REMITTANCE_URL}/remittance/request;
    "POST /api/payment/payment/request"                                  ${JAYPAY_PAYMENT_URL}/payment/request;
}

server {
    listen 8080;
    root /usr/share/nginx/html;

    resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

    location /api/ {
        if ($jaypay_upstream = "") {
            return 404;
        }
        proxy_pass $jaypay_upstream;
        proxy_connect_timeout 5s;
    }

    location / {
        try_files $uri /index.html;
    }
}
